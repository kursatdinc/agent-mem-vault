filters:
  and:
    - 'note["agent-written"] == true'
views:
  - type: table
    name: "Pending handoffs"
    filters:
      and:
        - 'note.kind == "handoff"'
        - 'note.read == false'
    order:
      - file.name
      - note.to
      - note.namespace
      - note.created
  - type: table
    name: "Decisions and risks"
    filters:
      and:
        - or:
            - 'note.kind == "decision"'
            - 'note.kind == "risk"'
        - 'note.validity == "valid"'
    groupBy:
      property: note.namespace
      direction: ASC
    order:
      - file.name
      - note.kind
      - note.status
      - note.created
  - type: table
    name: "All records"
    filters:
      and:
        - 'note.generated != true'
    order:
      - note.title
      - note.kind
      - note.namespace
      - note.created
      - note.status
